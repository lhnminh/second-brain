{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["iad1"],
  "functions": {
    "backend/app.py": {
      "maxDuration": 60,
      "includeFiles": "frontend/*.py",
      "excludeFiles": "{.env,.env.*,**/*.db,**/*.db-journal,backend/tests/**,**/__pycache__/**}"
    }
  }
}
