# Copy this file to .env without overwriting existing credentials.
# The backend reads the root .env; empty values use development defaults.

META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
META_VOICE_MODEL=muse-voice-transcribe-1.0

# PostgreSQL connection URL including SSL parameters; blank uses local SQLite.
DATABASE_URL=
# Stable workspace namespace, not a shared owner. Changing it selects new workspaces.
MOCK_USER_ID=demo-user
# Separate app access code for private demos; optional with PUBLIC_DEMO=true.
MOCK_AUTH_TOKEN=
# Explicitly allow visitors to use the hosted demo without an access code.
PUBLIC_DEMO=false
# Populate new, empty workspaces with editable example tasks.
SAMPLE_WORKSPACE=true
FRONTEND_ORIGIN=http://localhost:3000
